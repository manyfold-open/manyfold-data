# Local development secrets. Copy to .dev.vars (git-ignored); `npm run dev` reads it.

# Opens /settings and /api/admin/*. Unset, both stay closed.
# In production: npx wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=

# Seals Discord webhook URLs before they are stored (AES-GCM). At least 32 characters,
# e.g. from: openssl rand -base64 36
# Never rotate it in production: stored webhooks could no longer be opened.
# In production: npx wrangler secret put CONFIG_ENCRYPTION_KEY
CONFIG_ENCRYPTION_KEY=

# The origin links in Discord posts and feeds point to. Production sets it in wrangler.jsonc.
PUBLIC_ORIGIN=http://localhost:5173

# GA4 measurement id. Leave it empty locally: production's id lives in wrangler.jsonc, and
# pages served on any host but PUBLIC_ORIGIN's are never tagged anyway. To see the tag in
# development, use a fake id such as G-TESTLOCAL0, never the real one.
GA_MEASUREMENT_ID=
