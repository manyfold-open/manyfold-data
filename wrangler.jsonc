// Cloudflare Worker configuration for data.manyfold.ai.
//
// .github/workflows/ci.yml deploys this on every push to main: checks and tests first,
// then `npm run build` and `npx wrangler deploy`. The build step is load-bearing — the
// Cloudflare Vite plugin writes the config that wrangler actually deploys into dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manyfold-data",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request but static files reaches the Worker first: the API, each data app's
    // generated files, and the pages, which get the Google tag (src/worker/analytics.ts).
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.svg", "!/robots.txt", "!/og.png"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manyfold-data-db",
      // The production database (region WEUR). Local development never reads it:
      // `npm run dev` uses a local D1 in .wrangler/.
      "database_id": "60128000-5c82-4d08-ba14-9f93f11c2b5e"
    }
  ],
  "vars": {
    // Links in messages the cron sends (Discord), where there is no request to read it from.
    // Pages are only measured when served on this host.
    "PUBLIC_ORIGIN": "https://data.manyfold.ai",
    // GA4 measurement id (stream "Manyfold Data"). Empty serves no analytics at all; a
    // deployment of your own should put its own id here or leave it empty.
    "GA_MEASUREMENT_ID": "G-EP3B87GSTL",
    // Narra Messenger gateway runtime (enabled with bound Direct Matrix identity).
    "NARRA_GATEWAY_ENABLED": "on",
    "NARRA_SYNC": "on",
    // Push mode: Synapse wakes the sync Durable Object for each new event instead of it
    // long-polling /sync around the clock (billed as DO duration). Synapse only accepts a
    // pusher at exactly /_matrix/push/v1/notify, so this must be a hostname whose root this
    // Worker serves. Needs the NARRA_PUSH_SECRET secret (>= 16 chars, e.g. `openssl rand -hex 24`
    // | npx wrangler secret put NARRA_PUSH_SECRET); without it the kit keeps long-polling.
    "NARRA_SYNC_MODE": "push",
    // Group triage that works in any language, plus the elected fallback so a real question nobody
    // claims still gets one answer (narra-agent-kit README, "Group triage ..."). Unset to go back.
    "NARRA_GROUP_TRIAGE": "ask",
    // Chat-native (v2) pipeline from narra-agent-kit, only in the rooms listed: "zack test" and "Netmind London".
    // Every other room keeps the v1 pipeline. Set NARRA_PIPELINE to "v1" to switch it off.
    // v2 scores relevance with Workers AI embeddings (the AI binding below).
    "NARRA_PIPELINE": "v2",
    "NARRA_PIPELINE_ROOMS": "!ttLCzSZsdFiPSEPDyO:matrix.netmind.chat,!IftiIDGVmOgoqhisoa:matrix.netmind.chat",
    "NARRA_PUSH_URL": "https://data.manyfold.ai",
    "NARRA_AGENT_ID": "agt_agq66cw5uzyudifa4fuhcnaddu",
    "NARRA_MATRIX_ID": "@agent-37b08ab6:matrix.netmind.chat"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      { "name": "NARRA_SYNC_DO", "class_name": "NarraMatrixSync" },
      { "name": "NARRA_ROOM_DO", "class_name": "NarraRoomCoordinator" }
    ]
  },
  "migrations": [
    {
      "tag": "v1-narra-gateway",
      "new_sqlite_classes": ["NarraMatrixSync", "NarraRoomCoordinator"]
    }
  ],
  // Secrets, set with `npx wrangler secret put <NAME>`:
  //   ADMIN_PASSWORD          opens /api/admin/* and /settings
  //   CONFIG_ENCRYPTION_KEY   32+ characters; encrypts stored Discord webhooks. Never rotate it casually.
  // Every five minutes: expired leases, recheck tasks and old counters (src/worker/maintenance.ts),
  // then Discord posts for newly verified records (src/worker/notify.ts) and for readers' data
  // requests (src/worker/requests.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
  // A Workers custom domain: wrangler creates and manages its DNS record in the
  // manyfold.ai zone. It also turns off the *.workers.dev address.
  "routes": [{ "pattern": "data.manyfold.ai", "custom_domain": true }]
}
